{
  "name": "calsync",
  "version": "2.0.0",
  "description": "Synchronizes between CalDAV and Google Calendar",
  "main": "dist/app.js",
  "keywords": ["caldav", "nodejs", "typescript"],
  "author": "Romain Champourlier",
  "scripts": {
    "build": "bun run tsc",
    "dev": "bun run src/app.ts",
    "app": "node --trace-warnings ./dist/app.js",
    "test": "bun test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "ical.js": "^2.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.8.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
