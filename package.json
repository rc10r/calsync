{
  "name": "calsync",
  "version": "1.5.0",
  "description": "Synchronizes between CalDAV and Google Calendar",
  "main": "dist/app.js",
  "keywords": [
    "caldav",
    "nodejs",
    "typescript"
  ],
  "author": "Romain Champourlier",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node ./src/app.ts",
    "app:dev": "npm run build && node --trace-warnings ./dist/app.js",
    "app": "node --trace-warnings ./dist/app.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "googleapis": "^144.0.0",
    "ical.js": "^2.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/xml2js": "^0.4.14",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
